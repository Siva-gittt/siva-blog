<%- include('partials/header', { title: 'Add Post', user: user }) %>

<style>
  .composer-page { padding: 3rem 0 2rem; }
  .composer { max-width: 820px; margin: 0 auto; overflow: hidden; animation: blog-rise .7s var(--ease) backwards; }
  .composer-head { display: flex; align-items: center; gap: 1rem; padding: 1.7rem 2rem; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, rgba(15,139,141,.1), rgba(255,210,63,.16)); }
  .composer-icon { display: grid; flex: 0 0 52px; place-items: center; width: 52px; height: 52px; border-radius: 16px; font-size: 1.25rem; color: var(--mark); background: var(--ink); box-shadow: 0 10px 20px -8px rgba(15,30,43,.6); }
  .composer-head h2 { margin: 0; font-size: 1.8rem; letter-spacing: -.03em; }
  .composer .card-body { padding: 2rem; }
  .composer-lead { max-width: 60ch; margin-bottom: 1.75rem; color: var(--muted); font-size: 1.02rem; font-weight: 400; line-height: 1.65; }
  .field-foot { display: flex; justify-content: flex-end; margin-top: .4rem; color: var(--muted); font-size: .8rem; }
  #content { min-height: 150px; max-height: 420px; }

  /* Upload dropzone */
  .dropzone { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; min-height: 150px; padding: 1.5rem; color: var(--muted); text-align: center; border: 2px dashed #c3d0d8; border-radius: var(--r-md); background: #f9fbfb; transition: border-color .25s, background .25s, transform .25s var(--ease); }
  .dropzone:hover, .dropzone:focus-within, .dropzone.is-over { border-color: var(--brand); background: var(--brand-l); }
  .dropzone.is-over { transform: scale(1.012); }
  .dropzone input.form-control { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; opacity: 0; cursor: pointer; box-shadow: none; }
  .dropzone-icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: .35rem; border-radius: 16px; font-size: 1.3rem; color: var(--brand-d); background: #fff; box-shadow: var(--shadow-1); transition: transform .3s var(--ease); }
  .dropzone:hover .dropzone-icon, .dropzone.is-over .dropzone-icon { transform: translateY(-5px); }
  .dropzone strong { color: var(--ink); }
  .dropzone-count { min-height: 1.3em; color: var(--brand-d); font-size: .88rem; font-weight: 600; }

  /* Previews created by previewImages() */
  .preview-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: .75rem; margin-top: 1rem; }
  .preview-grid:empty { display: none; }
  #image-preview img.img-thumbnail { width: 100%; max-width: none !important; margin: 0 !important; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-md); box-shadow: var(--shadow-1); animation: blog-pop .4s var(--ease) backwards; transition: transform .3s var(--ease); }
  #image-preview img.img-thumbnail:hover { transform: scale(1.05) rotate(-1deg); }

  .composer-actions { display: flex; justify-content: flex-end; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  @media (max-width: 575.98px) { .composer-head, .composer .card-body { padding: 1.4rem; } .composer-actions .btn { width: 100%; } }
</style>

<main class="composer-page">
  <div class="container">
    <div class="card composer">
      <div class="card-header composer-head">
        <span class="composer-icon"><i class="fas fa-feather-alt"></i></span>
        <h2>Add New Post</h2>
      </div>
      <div class="card-body">
        <p class="lead composer-lead">
          Share your latest thoughts and updates by creating a new post. You can
          add images to make your post more engaging.
        </p>
        <% if (error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %> <% if (success) { %>
        <div class="alert alert-success" role="alert"><%= success %></div>
        <% } %>
        <form action="/posts/add" method="POST" enctype="multipart/form-data"  onsubmit="return validationForm()">
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control" name="title" id="title" required/>
            <div class="field-foot"><span id="title-count">0 characters</span></div>
          </div>
          <div class="mb-3">
            <label for="content" class="form-label">Content</label>
            <textarea
              class="form-control"
              name="content"
              id="content"
              rows="5"
              required
            ></textarea>
            <div class="field-foot"><span id="content-count">0 words</span></div>
          </div>
          <div class="mb-3">
            <label for="images" class="form-label">Images</label>
            <div class="dropzone" id="dropzone">
              <input
                class="form-control"
                type="file"
                name="images"
                id="images"
                multiple
                title=""
                onchange="previewImages()"
              />
              <span class="dropzone-icon"><i class="fas fa-cloud-upload-alt"></i></span>
              <strong>Drop images here</strong>
              <span>or click to browse</span>
              <span class="dropzone-count" id="file-count" aria-live="polite"></span>
            </div>
            <div class="preview-grid" id="image-preview"></div>
          </div>
          <div class="composer-actions">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-plus-circle"></i> Add Post
            </button>
          </div>
        </form>
      </div>
    </div>
    <script>
      function previewImages() {
        const preview = document.getElementById("image-preview");
        preview.innerHTML = "";
        const files = document.getElementById("images").files;
        for (let i = 0; i < files.length; i++) {
          const img = document.createElement("img");
          img.src = URL.createObjectURL(files[i]);
          img.classList.add("img-thumbnail", "mr-2", "mb-2");
          img.style.maxWidth = "150px";
          preview.appendChild(img);
        }
      }

      //form validation
      function validationForm() {
        const title = document.getElementById("title").value;
        const content = document.getElementById("content").value;
        if (!title || !content) {
          alert("Please fill in all fields");
          return false;
        }
        return true;
      }
    </script>
    <script>
      /* Cosmetic helpers: counters, auto-grow, dropzone highlight */
      (function () {
        var title = document.getElementById("title"), content = document.getElementById("content");
        var tc = document.getElementById("title-count"), cc = document.getElementById("content-count");
        title.addEventListener("input", function () { tc.textContent = title.value.length + " characters"; });
        content.addEventListener("input", function () {
          var w = (content.value.trim().match(/\S+/g) || []).length;
          cc.textContent = w + (w === 1 ? " word" : " words");
          content.style.height = "auto"; content.style.height = content.scrollHeight + 2 + "px";
        });
        var zone = document.getElementById("dropzone"), input = document.getElementById("images"), count = document.getElementById("file-count");
        ["dragenter", "dragover"].forEach(function (ev) { zone.addEventListener(ev, function () { zone.classList.add("is-over"); }); });
        ["dragleave", "drop"].forEach(function (ev) { zone.addEventListener(ev, function () { zone.classList.remove("is-over"); }); });
        input.addEventListener("change", function () {
          var n = input.files.length;
          count.textContent = n ? n + (n === 1 ? " image selected" : " images selected") : "";
        });
      })();
    </script>
  </div>
</main>

<%- include('partials/footer') %>
