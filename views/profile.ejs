<%- include('partials/header', { title: 'Profile', user: user }) %>

<style>
  .profile-page { padding: 3rem 0 2rem; }
  .profile-layout { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 2rem; align-items: start; }
  .profile-aside { position: sticky; top: 96px; }

  /* Profile card */
  .profile-card { overflow: hidden; animation: blog-rise .7s var(--ease) backwards; }
  .profile-cover { height: 104px; background: radial-gradient(70% 120% at 85% 0%, rgba(255,210,63,.55), transparent 60%), linear-gradient(135deg, var(--ink), #16485a 62%, var(--brand)); }
  .profile-card .card-body { padding: 0 1.6rem 1.7rem; }
  .profile-avatar { position: relative; display: block; width: 132px; height: 132px; margin: -66px auto 1rem; border: 5px solid #fff; border-radius: 50%; object-fit: cover; background: #fff; box-shadow: var(--shadow-2); transition: transform .5s var(--ease); }
  .profile-avatar:hover { transform: scale(1.05) rotate(-3deg); }
  .profile-name { margin-bottom: 1.25rem; font-size: 1.7rem; letter-spacing: -.03em; }
  .meta-row { display: flex; align-items: flex-start; gap: .85rem; margin: 0; padding: .8rem 0; border-top: 1px solid var(--line); text-align: left; overflow-wrap: anywhere; }
  .meta-row i { display: grid; flex: 0 0 34px; place-items: center; width: 34px; height: 34px; border-radius: 10px; font-size: .85rem; color: var(--brand-d); background: var(--brand-l); }
  .meta-row span { min-width: 0; color: var(--ink-2); font-size: .95rem; line-height: 1.4; }
  .meta-row strong { display: block; margin-bottom: .1rem; color: var(--muted); font-size: .76rem; font-weight: 600; }
  .profile-actions { margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .profile-actions form { margin: .75rem 0 0; }
  .profile-actions .btn-danger { color: var(--danger); border-color: transparent; background: var(--danger-l); box-shadow: none; }
  .profile-actions .btn-danger:hover { color: #fff; background: var(--danger); }

  /* Posts */
  .profile-main h2 { margin-bottom: 1.5rem; font-size: clamp(1.7rem, 3.5vw, 2.3rem); letter-spacing: -.035em; }
  .post-card { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-1); transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s; }
  /* .post-card:before { content: ""; position: absolute; left: 0; right: 0; top: 0; z-index: 2; height: 4px; background: linear-gradient(90deg, var(--brand), var(--mark)); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); } */
  .post-card:hover { transform: translateY(-6px); border-color: rgba(15,139,141,.35); box-shadow: var(--shadow-2); }
  /* .post-card:hover:before { transform: scaleX(1); } */
  .post-thumb { overflow: hidden; background: var(--brand-l); }
  .post-thumb img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .9s var(--ease); }
  .post-card:hover .post-thumb img { transform: scale(1.07); }
  .post-body { display: flex; flex: 1; flex-direction: column; gap: .6rem; padding: 1.3rem 1.4rem 1.4rem; }
  .post-title { display: -webkit-box; margin: 0; overflow: hidden; font-size: 1.2rem; line-height: 1.25; -webkit-line-clamp: 2; -webkit-box-orient: vertical; background: linear-gradient(var(--mark), var(--mark)) 0 96% / 0 .32em no-repeat; transition: background-size .4s var(--ease); }
  /* .post-card:hover .post-title { background-size: 100% .32em; } */
  .post-meta { margin: 0 0 .5rem; color: var(--muted); font-size: .87rem; }
  .post-more { align-self: flex-start; margin-top: auto; }
  .post-more i { margin-left: .35rem; }
  .post-card:hover .post-more i { transform: translateX(4px); }
  .empty-state { display: flex; flex-direction: column; align-items: center; gap: .9rem; padding: 3.5rem 1rem; color: var(--muted); text-align: center; border: 2px dashed #c9d5dc; border-radius: var(--r-lg); background: rgba(255,255,255,.6); }
  .empty-state p { margin: 0; font-size: 1.05rem; }
  .empty-icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 20px; font-size: 1.5rem; color: var(--brand-d); background: var(--brand-l); animation: blog-float 4s ease-in-out infinite alternate; }
  @media (max-width: 991.98px) { .profile-layout { grid-template-columns: 1fr; } .profile-aside { position: static; max-width: 460px; width: 100%; margin: 0 auto; } }
</style>

<main class="profile-page">
  <div class="container">
    <div class="profile-layout">
      <aside class="profile-aside">
        <div class="card profile-card">
          <div class="profile-cover" aria-hidden="true"></div>
          <div class="card-body text-center">
            <% if (user.profilePicture && user.profilePicture.url) { %>
            <img
              src="<%= user.profilePicture.url %>"
              class="profile-avatar"
              alt="Profile Picture"
            />
            <% } else { %>
            <img
              src="https://cdn.pixabay.com/photo/2015/12/13/20/43/doll-1091702_1280.jpg"
              class="profile-avatar"
              alt="Default Profile Picture"
            />
            <% } %>
            <h4 class="profile-name"><%= user.username %></h4>
            <p class="meta-row"><i class="fas fa-envelope"></i><span><strong>Email:</strong> <%= user.email %></span></p>
            <p class="meta-row"><i class="fas fa-quote-left"></i><span><strong>Bio:</strong> <%= user.bio %></span></p>
            <p class="meta-row">
              <i class="fas fa-calendar-alt"></i><span><strong>Date Joined:</strong> <%= user.createdAt.toDateString() %></span>
            </p>
            <p class="meta-row">
              <i class="fas fa-pen-nib"></i><span><strong>Number of Posts:</strong> <b class="count-up"><%= postCount %></b></span>
            </p>
            <div class="profile-actions">
              <a href="/user/edit" class="btn btn-primary btn-block"
                ><i class="fas fa-user-edit"></i> Edit Profile</a
              >
              <form action="/user/delete" method="POST">
                <button type="submit" class="btn btn-danger btn-block">
                  <i class="fas fa-user-times"></i> Delete Account
                </button>
              </form>
            </div>
          </div>
        </div>
      </aside>

      <section class="profile-main">
        <h2>Your Posts</h2>
        <div class="row">
          <% if (posts.length > 0) { %> <% posts.forEach(post => { %>
          <div class="col-sm-6 mb-4" data-reveal>
            <div class="post-card">
              <% if (post.images && post.images.length > 0) { %>
              <div class="post-thumb">
                <img
                  src="<%= post.images[0].url %>"
                  class="card-img-top"
                  alt="Post Image"
                />
              </div>
              <% } %>
              <div class="post-body">
                <h5 class="post-title"><%= post.title %></h5>
                <p class="post-meta"><%= post.createdAt.toDateString() %></p>
                <a href="/posts/<%= post._id %>" class="btn btn-primary btn-sm post-more stretched-link">Read More <i class="fas fa-arrow-right"></i></a>
              </div>
            </div>
          </div>
          <% }) %> <% } else { %>
          <div class="col-12">
            <div class="empty-state">
              <span class="empty-icon"><i class="far fa-file-alt"></i></span>
              <p>You have not created any posts yet.</p>
            </div>
          </div>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</main>

<script>
  /* Count the post total up on load */
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll(".count-up").forEach(function (el) {
      var n = parseInt(el.textContent, 10), start = null;
      if (isNaN(n) || n < 1) return;
      function step(t) {
        start = start || t;
        var p = Math.min((t - start) / 900, 1);
        el.textContent = Math.round(n * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(step);
      }
      el.textContent = "0";
      requestAnimationFrame(step);
    });
  })();
</script>

<%- include('partials/footer') %>
