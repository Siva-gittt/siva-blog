<%- include('partials/header', { title, user: user }) %>

<style>
  .posts-page { padding: 3.5rem 0 2rem; }
  .posts-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.25rem; margin-bottom: 2.25rem; }
  .posts-title { margin: 0; font-size: clamp(2.1rem, 5vw, 3.2rem); letter-spacing: -.04em; }
  .posts-count { margin-left: .35rem; color: var(--soft); font-weight: 500; }
  .posts-count b { color: var(--brand-d); font-weight: 700; }

  /* Search */
  .search-box { position: relative; width: min(100%, 360px); }
  .search-box > i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--soft); pointer-events: none; transition: color .2s; }
  .search-box:focus-within > i { color: var(--brand); }
  .search-box .form-control { padding: .8rem 3rem .8rem 2.75rem; border-radius: 999px; background: #fff; box-shadow: var(--shadow-1); }
  .search-box kbd { position: absolute; right: .9rem; top: 50%; transform: translateY(-50%); padding: .1rem .5rem; border: 1px solid var(--line); border-radius: 6px; color: var(--muted); font-family: var(--font-body); font-size: .78rem; background: var(--paper); pointer-events: none; }
  .search-box:focus-within kbd { opacity: 0; }
  .search-status { width: 100%; margin: -1rem 0 1.25rem; color: var(--muted); font-size: .88rem; }
  @media (hover: none) { .search-box kbd { display: none; } }

  /* Post card */
  .post-card { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); box-shadow: var(--shadow-1); transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s; }
  /* .post-card:before { content: ""; position: absolute; left: 0; right: 0; top: 0; z-index: 2; height: 4px; background: linear-gradient(90deg, var(--brand), var(--mark)); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); } */
  .post-card:hover { transform: translateY(-6px); border-color: rgba(15,139,141,.35); box-shadow: var(--shadow-2); }
  /* .post-card:hover:before { transform: scaleX(1); } */
  .post-thumb { overflow: hidden; background: var(--brand-l); }
  .post-thumb img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .9s var(--ease); }
  .post-card:hover .post-thumb img { transform: scale(1.07); }
  .post-body { display: flex; flex: 1; flex-direction: column; gap: .6rem; padding: 1.4rem 1.5rem 1.5rem; }
  .post-title { display: -webkit-box; margin: 0; overflow: hidden; font-size: 1.28rem; line-height: 1.25; -webkit-line-clamp: 2; -webkit-box-orient: vertical; background: linear-gradient(var(--mark), var(--mark)) 0 96% / 0 .32em no-repeat; transition: background-size .4s var(--ease); }
  /* .post-card:hover .post-title { background-size: 100% .32em; } */
  .post-meta { margin: 0 0 .6rem; color: var(--muted); font-size: .87rem; }
  .post-more { align-self: flex-start; margin-top: auto; }
  .post-more i { margin-left: .35rem; }
  .post-card:hover .post-more i { transform: translateX(4px); }

  /* Empty states */
  .empty-state { display: flex; flex-direction: column; align-items: center; gap: .9rem; padding: 4rem 1rem; color: var(--muted); text-align: center; border: 2px dashed #c9d5dc; border-radius: var(--r-lg); background: rgba(255,255,255,.6); }
  .empty-state p { margin: 0; font-size: 1.05rem; }
  .empty-icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 20px; font-size: 1.5rem; color: var(--brand-d); background: var(--brand-l); animation: blog-float 4s ease-in-out infinite alternate; }
</style>

<main class="posts-page">
  <div class="container">
    <div class="posts-head">
      <h1 class="posts-title">All Posts <span class="posts-count"> <b><%= posts.length %></b> </span></h1>
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="search" id="post-search" class="form-control" placeholder="Search posts" autocomplete="off" aria-label="Search posts" />
        <kbd>/</kbd>
      </div>
    </div>
    <div class="search-status" id="search-status" aria-live="polite"></div>

    <div class="row">
      <% if (posts.length > 0) { %> <% posts.forEach(post => { %>
      <div class="col-sm-6 col-lg-4 mb-4 post-item" data-reveal>
        <div class="post-card">
          <% if (post.images && post.images.length > 0) { %>
          <div class="post-thumb">
            <img
              src="<%= post.images[0].url %>"
              class="card-img-top"
              alt="Post Image"
            />
          </div>
          <% } %>
          <div class="post-body">
            <h5 class="post-title"><%= post.title %></h5>
            <p class="post-meta">
              by <%= post.author.username %> on <%= post.createdAt.toDateString() %>
            </p>
            <a href="/posts/<%= post._id %>" class="btn btn-primary btn-sm post-more stretched-link">Read More <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
      <% }) %> <% } else { %>
      <div class="col-12">
        <div class="empty-state">
          <span class="empty-icon"><i class="far fa-folder-open"></i></span>
          <p>No posts available.</p>
        </div>
      </div>
      <% } %>
    </div>

    <div class="empty-state" id="no-match" hidden>
      <span class="empty-icon"><i class="fas fa-search"></i></span>
      <p>No posts match your search.</p>
    </div>
  </div>
</main>

<script>
  (function () {
    var input = document.getElementById("post-search");
    var box = input.parentNode;
    var items = [].slice.call(document.querySelectorAll(".post-item"));
    var noMatch = document.getElementById("no-match");
    var status = document.getElementById("search-status");
    if (!items.length) { box.hidden = true; return; }
    var haystack = items.map(function (el) { return el.textContent.toLowerCase().replace(/\s+/g, " "); });

    function filter() {
      var q = input.value.trim().toLowerCase(), shown = 0;
      items.forEach(function (el, i) {
        var match = !q || haystack[i].indexOf(q) > -1;
        el.hidden = !match;
        if (match) shown++;
      });
      noMatch.hidden = shown > 0;
      status.textContent = q ? shown + " of " + items.length + " posts shown" : "";
    }
    input.addEventListener("input", filter);
    input.addEventListener("keydown", function (e) { if (e.key === "Escape") { input.value = ""; filter(); input.blur(); } });
    document.addEventListener("keydown", function (e) {
      if (e.key === "/" && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); input.focus(); }
    });
  })();
</script>

<%- include('partials/footer') %>
