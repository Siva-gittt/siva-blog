<%- include('partials/header', { title: 'Edit Post', user: user }) %>

<style>
  .composer-page { padding: 3rem 0 2rem; }
  .composer { max-width: 820px; margin: 0 auto; overflow: hidden; animation: blog-rise .7s var(--ease) backwards; }
  .composer-head { display: flex; align-items: center; gap: 1rem; padding: 1.7rem 2rem; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, rgba(15,139,141,.1), rgba(255,210,63,.16)); }
  .composer-icon { display: grid; flex: 0 0 52px; place-items: center; width: 52px; height: 52px; border-radius: 16px; font-size: 1.25rem; color: var(--mark); background: var(--ink); box-shadow: 0 10px 20px -8px rgba(15,30,43,.6); }
  .composer-head h1 { margin: 0; font-size: 1.8rem; letter-spacing: -.03em; }
  .composer .card-body { padding: 2rem; }
  #content { min-height: 170px; max-height: 460px; }

  /* Upload dropzone */
  .dropzone { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; min-height: 140px; padding: 1.5rem; color: var(--muted); text-align: center; border: 2px dashed #c3d0d8; border-radius: var(--r-md); background: #f9fbfb; transition: border-color .25s, background .25s, transform .25s var(--ease); }
  .dropzone:hover, .dropzone:focus-within, .dropzone.is-over { border-color: var(--brand); background: var(--brand-l); }
  .dropzone.is-over { transform: scale(1.012); }
  .dropzone input.form-control-file { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .dropzone-icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: .35rem; border-radius: 16px; font-size: 1.3rem; color: var(--brand-d); background: #fff; box-shadow: var(--shadow-1); transition: transform .3s var(--ease); }
  .dropzone:hover .dropzone-icon, .dropzone.is-over .dropzone-icon { transform: translateY(-5px); }
  .dropzone strong { color: var(--ink); }
  .dropzone-count { min-height: 1.3em; color: var(--brand-d); font-size: .88rem; font-weight: 600; }

  /* Current images */
  .current-caption { margin: 1.5rem 0 .75rem; color: var(--muted); font-size: .85rem; font-weight: 600; }
  .current-images { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: .75rem; }
  .current-images .thumb { width: 100%; aspect-ratio: 1; object-fit: cover; padding: .25rem; border: 1px solid var(--line); border-radius: var(--r-md); background: #fff; box-shadow: var(--shadow-1); transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
  .current-images .thumb:hover { transform: translateY(-4px) scale(1.04); box-shadow: var(--shadow-2); }

  .composer-actions { display: flex; justify-content: flex-end; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  @media (max-width: 575.98px) { .composer-head, .composer .card-body { padding: 1.4rem; } .composer-actions .btn { width: 100%; } }
</style>

<main class="composer-page">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <div class="card composer">
          <div class="card-header composer-head">
            <span class="composer-icon"><i class="fas fa-pen"></i></span>
            <h1>Edit Post</h1>
          </div>
          <div class="card-body">
            <form
              action="/posts/<%= post._id %>?_method=PUT"
              method="POST"
              enctype="multipart/form-data"
            >
              <div class="form-group">
                <label for="title">Title</label>
                <input
                  type="text"
                  class="form-control"
                  name="title"
                  id="title"
                  value="<%= post.title %>"
                  required
                />
              </div>
              <div class="form-group">
                <label for="content">Content</label>
                <textarea
                  class="form-control"
                  name="content"
                  id="content"
                  rows="5"
                  required
                >
<%= post.content %></textarea
                >
              </div>
              <div class="form-group">
                <label for="images">Images</label>
                <div class="dropzone" id="dropzone">
                  <input
                    type="file"
                    class="form-control-file"
                    name="images"
                    id="images"
                    title=""
                    multiple
                  />
                  <span class="dropzone-icon"><i class="fas fa-cloud-upload-alt"></i></span>
                  <strong>Drop images here</strong>
                  <span>or click to browse</span>
                  <span class="dropzone-count" id="file-count" aria-live="polite"></span>
                </div>
                <div class="current-images">
                  <% post.images.forEach(image => { %>
                  <img
                    src="<%= image.url %>"
                    alt="Post Image"
                    class="thumb"
                  />
                  <% }) %>
                </div>
              </div>
              <div class="composer-actions">
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save"></i> Update Post
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  /* Cosmetic helpers: dropzone highlight, file count, auto-grow, caption */
  (function () {
    var zone = document.getElementById("dropzone"), input = document.getElementById("images"), count = document.getElementById("file-count");
    ["dragenter", "dragover"].forEach(function (ev) { zone.addEventListener(ev, function () { zone.classList.add("is-over"); }); });
    ["dragleave", "drop"].forEach(function (ev) { zone.addEventListener(ev, function () { zone.classList.remove("is-over"); }); });
    input.addEventListener("change", function () {
      var n = input.files.length;
      count.textContent = n ? n + (n === 1 ? " new image selected" : " new images selected") : "";
    });

    var content = document.getElementById("content");
    function grow() { content.style.height = "auto"; content.style.height = content.scrollHeight + 2 + "px"; }
    content.addEventListener("input", grow); grow();

    var wrap = document.querySelector(".current-images");
    if (wrap.querySelector("img")) {
      var cap = document.createElement("div");
      cap.className = "current-caption"; cap.textContent = "Current images";
      wrap.parentNode.insertBefore(cap, wrap);
    }
  })();
</script>

<%- include('partials/footer') %>
