<%- include('partials/header', { title: title, user: user }) %>

<style>
  .error-page { position: relative; display: flex; align-items: center; justify-content: center; min-height: calc(100vh - var(--nav-h)); padding: 3rem 1rem; overflow: hidden; text-align: center; }
  .error-glow { position: absolute; width: 420px; height: 420px; border-radius: 50%; background: var(--danger); opacity: .14; filter: blur(90px); pointer-events: none; animation: blog-float 12s ease-in-out infinite alternate; }
  .error-card { position: relative; width: 100%; max-width: 560px; padding: 3rem 2.25rem 2.75rem; border: 1px solid var(--line); border-radius: 28px; background: var(--surface); box-shadow: var(--shadow-2); animation: blog-rise .8s var(--ease) both; }
  .error-icon { position: relative; display: grid; place-items: center; width: 92px; height: 92px; margin: 0 auto 1.6rem; border-radius: 50%; font-size: 2.1rem; color: var(--danger); background: var(--danger-l); }
  .error-icon:before { content: ""; position: absolute; inset: -10px; border: 2px dashed rgba(224,68,88,.45); border-radius: 50%; animation: blog-spin 16s linear infinite; }
  .error-icon i { animation: error-shake 3.2s ease-in-out 1s infinite; }
  .error-title { margin-bottom: .9rem; font-size: clamp(2rem, 5vw, 2.7rem); letter-spacing: -.04em; }
  .error-message { margin: 0 auto 2rem; padding: .9rem 1.1rem; border-left: 4px solid var(--danger); border-radius: var(--r-sm); color: #8f1f31; font-size: 1.02rem; font-weight: 500; text-align: left; background: var(--danger-l); overflow-wrap: anywhere; }
  @keyframes error-shake { 0%, 8%, 100% { transform: rotate(0); } 2% { transform: rotate(-12deg); } 4% { transform: rotate(10deg); } 6% { transform: rotate(-6deg); } }
</style>

<main class="error-page">
  <span class="error-glow" aria-hidden="true"></span>
  <div class="error-card">
    <div class="error-icon" aria-hidden="true"><i class="fas fa-exclamation-triangle"></i></div>
    <h1 class="error-title">Something went wrong</h1>
    <p class="lead error-message" role="alert"><%= error %></p>
    <a href="/" class="btn btn-primary btn-lg"><i class="fas fa-home"></i> Go Home</a>
  </div>
</main>

<%- include('partials/footer') %>
